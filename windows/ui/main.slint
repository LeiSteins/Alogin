import { Button, CheckBox, ComboBox, LineEdit, TextEdit, NavigationItem } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";
import { AccountCard } from "account-card.slint";
import { AppTheme } from "theme.slint";
export { AppTheme }

export global Labels {
    in property <string> app;
    in property <string> home;
    in property <string> accounts-page;
    in property <string> network-page;
    in property <string> toggle-navigation;
    in property <string> network-title;
    in property <string> network-name;
    in property <string> network-ipv4;
    in property <string> account-title;
    in property <string> account-username;
    in property <string> remaining-money;
    in property <string> retry-fetch;
    in property <string> traffic-progress;
    in property <string> accounts;
    in property <string> username;
    in property <string> password;
    in property <string> save;
    in property <string> delete;
    in property <string> targets;
    in property <string> auto;
    in property <string> save-settings;
}

component NetworkCard inherits Rectangle {
    in property <string> name;
    in property <string> ipv4;
    height: content-layout.min-height;
    background: AppTheme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: AppTheme.border;
    content-layout := VerticalLayout {
        padding: 16px;
        spacing: 0px;
        Text {
            text: Labels.network-title;
            color: AppTheme.accent;
            font-weight: 700;
            vertical-stretch: 0;
        }
        VerticalLayout {
            padding-top: 12px;
            spacing: 4px;
            Text { text: Labels.network-name; color: AppTheme.muted; font-size: 14px; }
            Text {
                text: root.name;
                color: AppTheme.text;
                font-size: 18px;
                font-weight: 700;
                wrap: word-wrap;
                height: self.preferred-height;
            }
        }
        VerticalLayout {
            padding-top: 12px;
            spacing: 4px;
            Text { text: Labels.network-ipv4; color: AppTheme.muted; font-size: 14px; }
            Text {
                text: root.ipv4;
                color: AppTheme.text;
                font-size: 18px;
                font-weight: 700;
                wrap: word-wrap;
                height: self.preferred-height;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: Labels.app;
    preferred-width: 860px;
    preferred-height: 560px;
    min-width: 660px;
    min-height: 386px;
    background: AppTheme.chrome;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    in property <bool> ready;
    in property <bool> show-account;
    in property <string> network-name;
    in property <string> network-ipv4;
    in property <string> account-name;
    in property <string> account-balance;
    in property <string> account-error;
    in property <bool> has-overview;
    in property <bool> show-traffic;
    in property <float> traffic-progress;
    in property <string> traffic-used-percent;
    in property <string> traffic-amount;
    in property <string> action-label;
    in property <[string]> accounts;
    in-out property <int> account-index: -1;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> targets;
    in-out property <bool> auto-login;
    private property <length> home-card-height: root.show-account && home-cards.stacked
        ? network-card-view.height + 20px + account-card-view.height
        : max(network-card-view.height, root.show-account ? account-card-view.height : 0px);
    private property <int> page;
    private property <bool> compact-navigation;
    callback home-action();
    callback save-account();
    callback delete-account();
    callback select-account();
    callback save-settings();

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: root.compact-navigation ? 52px : 168px;
            animate width { duration: 180ms; easing: ease-in-out; }
            background: AppTheme.chrome;
            VerticalLayout {
                padding-top: 12px;
                padding-left: 6px;
                padding-right: 6px;
                padding-bottom: 12px;
                spacing: 4px;
                NavigationItem {
                    text: Labels.toggle-navigation;
                    checkable: false;
                    compact: true;
                    width: 40px;
                    icon: root.compact-navigation
                        ? @image-url("../resources/navigation/panel-left-open.svg")
                        : @image-url("../resources/navigation/panel-left-close.svg");
                    clicked => { root.compact-navigation = !root.compact-navigation; }
                }
                NavigationItem {
                    text: Labels.home;
                    icon: @image-url("../resources/navigation/house.svg");
                    selected: root.page == 0;
                    compact: root.compact-navigation;
                    clicked => { root.page = 0; }
                }
                NavigationItem {
                    text: Labels.accounts-page;
                    icon: @image-url("../resources/navigation/folder-user.svg");
                    selected: root.page == 1;
                    compact: root.compact-navigation;
                    clicked => { root.page = 1; }
                }
                NavigationItem {
                    text: Labels.network-page;
                    icon: @image-url("../resources/navigation/wifi.svg");
                    selected: root.page == 2;
                    compact: root.compact-navigation;
                    clicked => { root.page = 2; }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        // Keep each page instantiated: switching pages preserves form drafts.
        Rectangle {
            horizontal-stretch: 1;
            background: AppTheme.background;
            border-top-left-radius: 12px;
            Rectangle {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                height: parent.height - 48px;
                VerticalLayout {
                    visible: root.page == 0;
                    spacing: 20px;
                    ScrollView {
                        vertical-stretch: 1;
                        content-width: max(250px, self.visible-width);
                        content-height: max(self.visible-height, root.home-card-height);
                        home-cards := Rectangle {
                            private property <bool> stacked: root.show-account && self.width < 620px;
                            private property <length> card-width: min(600px, max(250px,
                                root.show-account && !self.stacked ? (self.width - 20px) / 2 : self.width));
                            x: 0px;
                            y: 0px;
                            width: max(250px, parent.visible-width);
                            height: root.home-card-height;
                            network-card-view := NetworkCard {
                                name: root.network-name;
                                ipv4: root.network-ipv4;
                                x: 0px;
                                y: 0px;
                                width: parent.card-width;
                            }
                            account-card-view := AccountCard {
                                visible: root.show-account;
                                title: Labels.account-title;
                                username-label: Labels.account-username;
                                balance-label: Labels.remaining-money;
                                progress-label: Labels.traffic-progress;
                                retry-label: Labels.retry-fetch;
                                username: root.account-name;
                                balance: root.account-balance;
                                error: root.account-error;
                                has-overview: root.has-overview;
                                usage-known: root.show-traffic;
                                usage: root.traffic-progress;
                                used-percent: root.traffic-used-percent;
                                traffic-amount: root.traffic-amount;
                                enabled: root.ready;
                                x: parent.stacked ? 0px : parent.card-width + 20px;
                                y: parent.stacked ? network-card-view.height + 20px : 0px;
                                width: parent.card-width;
                                retry => { root.home-action(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: root.action-label;
                            width: 148px;
                            height: 36px;
                            enabled: root.ready;
                            primary: true;
                            clicked => { root.home-action(); }
                        }
                    }
                }
                VerticalLayout {
                    visible: root.page == 1;
                    spacing: 12px;
                    Text { text: Labels.accounts; color: AppTheme.text; }
                    HorizontalLayout {
                        spacing: 12px;
                        ComboBox {
                            label: Labels.accounts;
                            model: root.accounts;
                            current-index <=> root.account-index;
                            enabled: root.ready && root.accounts.length > 0;
                            horizontal-stretch: 1;
                            selected => { root.select-account(); }
                        }
                        Button {
                            text: Labels.delete;
                            enabled: root.ready && root.account-index >= 0;
                            clicked => { root.delete-account(); }
                        }
                    }
                    Text { text: Labels.username; color: AppTheme.text; }
                    LineEdit { label: Labels.username; text <=> root.username; enabled: root.ready; }
                    Text { text: Labels.password; color: AppTheme.text; }
                    LineEdit {
                        label: Labels.password;
                        text <=> root.password;
                        input-type: InputType.password;
                        enabled: root.ready;
                        accepted => { root.save-account(); }
                    }
                    HorizontalLayout {
                        Button {
                            text: Labels.save;
                            enabled: root.ready;
                            primary: true;
                            clicked => { root.save-account(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
                VerticalLayout {
                    visible: root.page == 2;
                    spacing: 12px;
                    Text { text: Labels.targets; color: AppTheme.text; }
                    TextEdit {
                        label: Labels.targets;
                        text <=> root.targets;
                        enabled: root.ready;
                        vertical-stretch: 1;
                    }
                    CheckBox {
                        text: Labels.auto;
                        checked <=> root.auto-login;
                        enabled: root.ready;
                    }
                    HorizontalLayout {
                        Button {
                            text: Labels.save-settings;
                            enabled: root.ready;
                            primary: true;
                            clicked => { root.save-settings(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
    }
}

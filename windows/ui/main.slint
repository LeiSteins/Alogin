import { Button, LineEdit, NavigationItem } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";
import { AccountCard } from "account-card.slint";
import { DeviceCard, DeviceRow } from "device-card.slint";
export { DeviceRow }
import { AppTheme } from "theme.slint";
export { AppTheme }
import { SettingsPage, AboutPage, PreferencesLabels } from "preferences.slint";
export { PreferencesLabels }
import { MaintenancePage, MaintenanceLabels } from "maintenance.slint";
export { MaintenanceLabels }

export global Labels {
    in property <string> app;
    in property <string> home;
    in property <string> accounts-page;
    in property <string> network-page;
    in property <string> toggle-navigation;
    in property <string> network-title;
    in property <string> network-name;
    in property <string> network-ipv4;
    in property <string> account-title;
    in property <string> account-username;
    in property <string> remaining-money;
    in property <string> retry-fetch;
    in property <string> traffic-progress;
    in property <string> accounts;
    in property <string> no-saved-accounts;
    in property <string> username;
    in property <string> password;
    in property <string> add-account;
    in property <string> edit-account;
    in property <string> cancel;
    in property <string> save;
    in property <string> delete;
    in property <string> targets;
    in property <string> wifi-name;
    in property <string> add-wifi;
    in property <string> add;
    in property <string> delete-wifi;
    in property <string> no-targets;
    in property <string> add-current-wifi;
    in property <string> devices-title;
    in property <string> no-devices;
    in property <string> current-device;
    in property <string> logout-device;
}

component NetworkCard inherits Rectangle {
    in property <string> name;
    in property <string> ipv4;
    height: content-layout.min-height;
    background: AppTheme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: AppTheme.border;
    content-layout := VerticalLayout {
        padding: 16px;
        spacing: 0px;
        Text {
            text: Labels.network-title;
            color: AppTheme.accent;
            font-weight: 700;
            vertical-stretch: 0;
        }
        VerticalLayout {
            padding-top: 12px;
            spacing: 4px;
            Text { text: Labels.network-name; color: AppTheme.muted; font-size: 14px; }
            Text {
                text: root.name;
                color: AppTheme.text;
                font-size: 18px;
                font-weight: 700;
                wrap: word-wrap;
                height: self.preferred-height;
            }
        }
        VerticalLayout {
            padding-top: 12px;
            spacing: 4px;
            Text { text: Labels.network-ipv4; color: AppTheme.muted; font-size: 14px; }
            Text {
                text: root.ipv4;
                color: AppTheme.text;
                font-size: 18px;
                font-weight: 700;
                wrap: word-wrap;
                height: self.preferred-height;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: Labels.app;
    preferred-width: 860px;
    preferred-height: 560px;
    min-width: 660px;
    min-height: 386px;
    background: AppTheme.chrome;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    in property <bool> ready;
    in property <bool> show-account;
    in property <bool> show-devices;
    in property <[DeviceRow]> devices;
    in property <string> devices-error;
    in property <bool> devices-available;
    in property <string> device-generation;
    out property <string> requested-device;
    out property <string> requested-generation;
    in property <string> network-name;
    in property <string> network-ipv4;
    in property <bool> can-add-current-wifi;
    in property <string> account-name;
    in property <string> account-balance;
    in property <string> account-error;
    in property <bool> has-overview;
    in property <bool> show-traffic;
    in property <float> traffic-progress;
    in property <string> traffic-used-percent;
    in property <string> traffic-amount;
    in property <string> action-label;
    in property <[string]> accounts;
    in-out property <int> account-index: -1;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <bool> account-editor-open;
    in-out property <bool> saving-account;
    private property <bool> editing-account;
    private property <bool> editor-open: root.account-editor-open || root.target-editor-open;
    private property <bool> page-enabled: root.ready && !root.editor-open;
    in-out property <[string]> target-items;
    in-out property <int> target-index: -1;
    in-out property <string> target-name;
    in-out property <string> target-error;
    in-out property <bool> target-editor-open;
    in-out property <bool> saving-target;
    in-out property <bool> auto-login;
    in-out property <bool> startup-enabled;
    in property <string> startup-error;
    in-out property <int> check-interval;
    in-out property <int> retry-initial;
    in-out property <int> retry-max;
    in-out property <bool> pause-after-logout;
    in property <string> maintenance-status;
    in property <string> maintenance-detail;
    in-out property <int> appearance;
    private property <length> summary-height: root.show-account && home-cards.stacked
        ? network-card-view.height + 20px + account-card-view.height
        : max(network-card-view.height, root.show-account ? account-card-view.height : 0px);
    private property <length> home-card-height: root.summary-height
        + (root.show-devices ? 20px + device-card-view.height : 0px);
    private property <int> page;
    private property <bool> compact-navigation;
    callback home-action();
    callback logout-device();
    callback save-account();
    callback delete-account();
    callback select-account();
    callback save-auto-login();
    callback save-startup();
    callback save-maintenance();
    callback resume-maintenance();
    callback save-appearance();
    callback open-about-link(int);
    callback add-current-wifi();
    callback add-target();
    callback delete-target();

    changed target-index => { root.reveal-target(); }

    function reveal-target() {
        if root.target-index >= 0 {
            if root.target-index * 48px + target-scroll.content-y < 0px {
                target-scroll.content-y = -root.target-index * 48px;
            }
            if root.target-index * 48px + 44px + target-scroll.content-y > target-scroll.visible-height {
                target-scroll.content-y = target-scroll.visible-height - (root.target-index * 48px + 44px);
            }
        }
    }

    function open-account-editor(edit: bool) {
        if root.page-enabled {
            if edit || root.editing-account {
                root.username = edit ? root.accounts[root.account-index] : "";
                root.password = "";
            }
            root.editing-account = edit;
            root.account-editor-open = true;
            editor-username.focus();
        }
    }
    public function close-account-editor() {
        if !root.saving-account {
            root.account-editor-open = false;
            add-account-button.focus();
        }
    }
    function open-target-editor() {
        if root.page-enabled {
            root.target-editor-open = true;
            editor-wifi-name.focus();
        }
    }
    public function close-target-editor() {
        if root.target-editor-open && !root.saving-target {
            root.target-editor-open = false;
            add-wifi-button.focus();
        }
    }

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: root.compact-navigation ? 52px : 168px;
            animate width { duration: 180ms; easing: ease-in-out; }
            background: AppTheme.chrome;
            VerticalLayout {
                padding-top: 12px;
                padding-left: 6px;
                padding-right: 6px;
                padding-bottom: 12px;
                spacing: 4px;
                NavigationItem {
                    enabled: !root.editor-open;
                    text: Labels.toggle-navigation;
                    checkable: false;
                    compact: true;
                    width: 40px;
                    icon: root.compact-navigation
                        ? @image-url("../resources/navigation/panel-left-open.svg")
                        : @image-url("../resources/navigation/panel-left-close.svg");
                    clicked => { root.compact-navigation = !root.compact-navigation; }
                }
                NavigationItem {
                    enabled: !root.editor-open;
                    text: Labels.home;
                    icon: @image-url("../resources/navigation/house.svg");
                    selected: root.page == 0;
                    compact: root.compact-navigation;
                    clicked => { root.page = 0; }
                }
                NavigationItem {
                    enabled: !root.editor-open;
                    text: Labels.accounts-page;
                    icon: @image-url("../resources/navigation/folder-user.svg");
                    selected: root.page == 1;
                    compact: root.compact-navigation;
                    clicked => { root.page = 1; }
                }
                NavigationItem {
                    enabled: !root.editor-open;
                    text: Labels.network-page;
                    icon: @image-url("../resources/navigation/wifi.svg");
                    selected: root.page == 2;
                    compact: root.compact-navigation;
                    clicked => { root.page = 2; }
                }
                NavigationItem {
                    enabled: !root.editor-open;
                    text: MaintenanceLabels.title;
                    icon: @image-url("../resources/navigation/globe-check.svg");
                    selected: root.page == 5;
                    compact: root.compact-navigation;
                    clicked => { root.page = 5; }
                }
                Rectangle { vertical-stretch: 1; }
                NavigationItem {
                    enabled: !root.editor-open;
                    text: PreferencesLabels.settings;
                    icon: @image-url("../resources/navigation/settings.svg");
                    selected: root.page == 3;
                    compact: root.compact-navigation;
                    clicked => { root.page = 3; }
                }
                NavigationItem {
                    enabled: !root.editor-open;
                    text: PreferencesLabels.about;
                    icon: @image-url("../resources/navigation/info.svg");
                    selected: root.page == 4;
                    compact: root.compact-navigation;
                    clicked => { root.page = 4; }
                }
            }
        }
        // Keep each page instantiated: switching pages preserves form drafts.
        Rectangle {
            horizontal-stretch: 1;
            background: AppTheme.background;
            border-top-left-radius: 12px;
            Rectangle {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                height: parent.height - 48px;
                SettingsPage {
                    visible: root.page == 3;
                    enabled: root.page-enabled;
                    auto-login <=> root.auto-login;
                    startup-enabled <=> root.startup-enabled;
                    startup-error: root.startup-error;
                    appearance <=> root.appearance;
                    save-auto-login => { root.save-auto-login(); }
                    save-startup => { root.save-startup(); }
                    save-appearance => { root.save-appearance(); }
                }
                MaintenancePage {
                    visible: root.page == 5;
                    enabled: root.page-enabled;
                    auto-login <=> root.auto-login;
                    check-interval <=> root.check-interval;
                    retry-initial <=> root.retry-initial;
                    retry-max <=> root.retry-max;
                    pause-after-logout <=> root.pause-after-logout;
                    status: root.maintenance-status;
                    detail: root.maintenance-detail;
                    save-auto-login => { root.save-auto-login(); }
                    save-maintenance => { root.save-maintenance(); }
                    resume => { root.resume-maintenance(); }
                }
                AboutPage {
                    visible: root.page == 4;
                    open-link(index) => { root.open-about-link(index); }
                }
                VerticalLayout {
                    visible: root.page == 0;
                    spacing: 20px;
                    home-scroll := ScrollView {
                        vertical-stretch: 1;
                        content-width: max(250px, self.visible-width);
                        content-height: max(self.visible-height, root.home-card-height);
                        home-cards := Rectangle {
                            private property <bool> stacked: root.show-account && self.width < 620px;
                            private property <length> card-width: min(600px, max(250px,
                                root.show-account && !self.stacked ? (self.width - 20px) / 2 : self.width));
                            x: 0px;
                            y: 0px;
                            width: max(250px, parent.visible-width);
                            height: root.home-card-height;
                            network-card-view := NetworkCard {
                                name: root.network-name;
                                ipv4: root.network-ipv4;
                                x: 0px;
                                y: 0px;
                                width: parent.card-width;
                            }
                            account-card-view := AccountCard {
                                visible: root.show-account;
                                title: Labels.account-title;
                                username-label: Labels.account-username;
                                balance-label: Labels.remaining-money;
                                progress-label: Labels.traffic-progress;
                                retry-label: Labels.retry-fetch;
                                username: root.account-name;
                                balance: root.account-balance;
                                error: root.account-error;
                                has-overview: root.has-overview;
                                usage-known: root.show-traffic;
                                usage: root.traffic-progress;
                                used-percent: root.traffic-used-percent;
                                traffic-amount: root.traffic-amount;
                                enabled: root.page-enabled;
                                x: parent.stacked ? 0px : parent.card-width + 20px;
                                y: parent.stacked ? network-card-view.height + 20px : 0px;
                                width: parent.card-width;
                                retry => { root.home-action(); }
                            }
                            device-card-view := DeviceCard {
                                visible: root.show-devices;
                                x: 0px;
                                y: root.summary-height + 20px;
                                width: parent.stacked ? parent.card-width : parent.card-width * 2 + 20px;
                                title: Labels.devices-title;
                                empty-label: Labels.no-devices;
                                current-label: Labels.current-device;
                                logout-label: Labels.logout-device;
                                retry-label: Labels.retry-fetch;
                                devices: root.devices;
                                available: root.devices-available;
                                error: root.devices-error;
                                enabled: root.page-enabled;
                                retry => { root.home-action(); }
                                logout(id) => {
                                    root.requested-device = id;
                                    root.requested-generation = root.device-generation;
                                    root.logout-device();
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: root.action-label;
                            width: 148px;
                            height: 36px;
                            enabled: root.page-enabled;
                            primary: true;
                            clicked => { root.home-action(); }
                        }
                    }
                }
                VerticalLayout {
                    visible: root.page == 1;
                    spacing: 12px;
                    HorizontalLayout {
                        Text { text: Labels.accounts; color: AppTheme.text; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        add-account-button := Button {
                            text: Labels.add-account;
                            enabled: root.page-enabled;
                            primary: true;
                            clicked => { root.open-account-editor(false); }
                        }
                    }
                    Rectangle {
                        background: AppTheme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: AppTheme.border;
                        vertical-stretch: 1;
                        accessible-role: groupbox;
                        accessible-label: Labels.accounts;
                        ScrollView {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            content-width: self.visible-width;
                            VerticalLayout {
                                spacing: 4px;
                                for account[index] in root.accounts: NavigationItem {
                                    height: 44px;
                                    text: account;
                                    icon: @image-url("../resources/navigation/folder-user.svg");
                                    selected: root.account-index == index;
                                    enabled: root.page-enabled;
                                    clicked => {
                                        if root.account-index != index {
                                            root.account-index = index;
                                            root.select-account();
                                        }
                                    }
                                }
                            }
                        }
                        if root.accounts.length == 0: Text {
                            x: 16px;
                            width: parent.width - 32px;
                            text: Labels.no-saved-accounts;
                            color: AppTheme.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: Labels.edit-account;
                            enabled: root.page-enabled && root.account-index >= 0;
                            clicked => { root.open-account-editor(true); }
                        }
                        Button {
                            text: Labels.delete;
                            enabled: root.page-enabled && root.account-index >= 0;
                            clicked => { root.delete-account(); }
                        }
                    }
                }
                VerticalLayout {
                    visible: root.page == 2;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: Labels.targets; color: AppTheme.text; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: Labels.add-current-wifi;
                            enabled: root.page-enabled && root.can-add-current-wifi;
                            clicked => { root.add-current-wifi(); }
                        }
                        add-wifi-button := Button {
                            text: Labels.add-wifi;
                            enabled: root.page-enabled;
                            primary: true;
                            clicked => { root.open-target-editor(); }
                        }
                    }
                    Rectangle {
                        background: AppTheme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: AppTheme.border;
                        vertical-stretch: 1;
                        accessible-role: groupbox;
                        accessible-label: Labels.targets;
                        target-scroll := ScrollView {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            content-width: self.visible-width;
                            changed visible-height => { root.reveal-target(); }
                            VerticalLayout {
                                spacing: 4px;
                                for ssid[index] in root.target-items: NavigationItem {
                                    height: 44px;
                                    text: ssid;
                                    icon: @image-url("../resources/navigation/wifi.svg");
                                    selected: root.target-index == index;
                                    enabled: root.page-enabled;
                                    clicked => { root.target-index = index; }
                                }
                            }
                        }
                        if root.target-items.length == 0: Text {
                            x: 16px;
                            width: parent.width - 32px;
                            text: Labels.no-targets;
                            color: AppTheme.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: Labels.delete-wifi;
                            enabled: root.page-enabled && root.target-index >= 0
                                && root.target-index < root.target-items.length;
                            clicked => { root.delete-target(); }
                        }
                    }
                }
            }
        }
    }

    // Keep the editor inside the client area and centered during window resizing.
    Rectangle {
        visible: root.target-editor-open;
        background: AppTheme.scrim;
        TouchArea { }
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close-target-editor();
                    return accept;
                }
                return reject;
            }
            target-editor := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(420px, parent.width - 48px);
                height: target-editor-layout.min-height;
                background: AppTheme.surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: AppTheme.border;
                accessible-role: groupbox;
                accessible-label: Labels.add-wifi;
                target-editor-layout := VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    Text {
                        text: Labels.add-wifi;
                        color: AppTheme.text;
                        font-size: 20px;
                        font-weight: 700;
                    }
                    Text { text: Labels.wifi-name; color: AppTheme.text; }
                    editor-wifi-name := LineEdit {
                        label: Labels.wifi-name;
                        text <=> root.target-name;
                        enabled: root.ready;
                        accepted => { if root.ready { root.add-target(); } }
                    }
                    if root.target-error != "": Text {
                        text: root.target-error;
                        color: AppTheme.error;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        padding-top: 8px;
                        spacing: 12px;
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: Labels.cancel;
                            enabled: !root.saving-target;
                            clicked => { root.close-target-editor(); }
                        }
                        Button {
                            text: root.saving-target ? root.action-label : Labels.add;
                            enabled: root.ready && root.target-name != "";
                            primary: true;
                            clicked => { root.add-target(); }
                        }
                    }
                }
            }
        }
    }
    Rectangle {
        visible: root.account-editor-open;
        background: AppTheme.scrim;
        TouchArea { }
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close-account-editor();
                    return accept;
                }
                return reject;
            }
            account-editor := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(420px, parent.width - 48px);
                height: editor-layout.min-height;
                background: AppTheme.surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: AppTheme.border;
                accessible-role: groupbox;
                accessible-label: root.editing-account ? Labels.edit-account : Labels.add-account;
                editor-layout := VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    Text {
                        text: root.editing-account ? Labels.edit-account : Labels.add-account;
                        color: AppTheme.text;
                        font-size: 20px;
                        font-weight: 700;
                    }
                    Text { text: Labels.username; color: AppTheme.text; }
                    editor-username := LineEdit {
                        label: Labels.username;
                        text <=> root.username;
                        enabled: root.ready;
                        accepted => { editor-password.focus(); }
                    }
                    Text { text: Labels.password; color: AppTheme.text; wrap: word-wrap; }
                    editor-password := LineEdit {
                        label: Labels.password;
                        text <=> root.password;
                        input-type: InputType.password;
                        enabled: root.ready;
                        accepted => { if root.ready { root.save-account(); } }
                    }
                    HorizontalLayout {
                        padding-top: 8px;
                        spacing: 12px;
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: Labels.cancel;
                            enabled: !root.saving-account;
                            clicked => { root.close-account-editor(); }
                        }
                        Button {
                            text: root.saving-account ? root.action-label : Labels.save;
                            enabled: root.ready;
                            primary: true;
                            clicked => { root.save-account(); }
                        }
                    }
                }
            }
        }
    }
}

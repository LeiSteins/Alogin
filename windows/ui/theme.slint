export global AppTheme {
    in property <bool> dark;
    in property <bool> high-contrast;
    in property <color> background;
    in property <color> chrome;
    in property <color> surface;
    out property <color> scrim: #00000080;
    in property <color> input;
    in property <color> button;
    in property <color> button-text;
    in property <color> hover;
    in property <color> navigation-selected;
    in property <color> pressed;
    in property <color> text;
    in property <color> muted;
    in property <color> error;
    in property <color> border;
    in property <color> accent;
    in property <color> accent-text;
}

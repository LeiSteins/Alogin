// Keep ID 101 in sync with src/platform/icon.rs.
101 ICON "resources/alogin.ico"

1 VERSIONINFO
FILEVERSION @VERSION_COMMA@
PRODUCTVERSION @VERSION_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "LeiSteins\0"
            VALUE "FileDescription", "Alogin Windows\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "alogin-windows\0"
            VALUE "OriginalFilename", "alogin-windows.exe\0"
            VALUE "ProductName", "Alogin\0"
            VALUE "ProductVersion", "@VERSION@\0"
            VALUE "LegalCopyright", "GPL-3.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
